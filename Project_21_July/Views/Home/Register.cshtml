@model Project_21_July1.Models.Student

<div class="text-center">
    <h1 class="display-4">Student Admisiion Form</h1>
    
</div>
@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <table>
        <tr>
            <td>Name :</td>
            <td>@Html.TextBoxFor(m => m.name)@Html.ValidationMessageFor(m =>m.name)</td>
        </tr>

        <tr>
            <td>Age :</td>
            <td>@Html.TextBoxFor(m => m.age)@Html.ValidationMessageFor(m => m.age)</td>
        </tr>

        <tr>
            <td>Email :</td>
            <td>@Html.TextBoxFor(m => m.email)@Html.ValidationMessageFor(m => m.email)</td>
        </tr>

        <tr>
            <td>Course :</td>
            <td>@Html.TextBoxFor(m => m.course)@Html.ValidationMessageFor(m => m.course)</td>
        </tr>

        <tr>
            <td></td>
            <td><Minput type="submit" value="Register"/></td>
        </tr>

    </table>
}
@if (ViewBag.Message != null)
{
    <h3 style="color:green">@ViewBag.Message</h3>
}